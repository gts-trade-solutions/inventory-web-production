# ---------------------------------------------------------------------------
# Inventory App — environment
#
# Copy to .env and fill in. NEVER commit a filled-in copy (.gitignore already excludes it).
# Prisma CLI reads .env; Next.js reads it too, so one file serves both.
# Run scripts/setup-mysql.sql first to create both databases and the app user.
# ---------------------------------------------------------------------------

# --- Databases -------------------------------------------------------------
# Two databases, identical schema. Mode is resolved per request from the signed
# session or JWT and selects one of these (ARCHITECTURE §8, WADR-023/024).
#
# URL-encode special characters in the password: @ -> %40, # -> %23, : -> %3A
DATABASE_URL="mysql://inventory_app:CHANGE_ME@localhost:3306/inventory"
DATABASE_URL_DEMO="mysql://inventory_app:CHANGE_ME@localhost:3306/inventory_demo"

# Integration tests run against real MySQL and TRUNCATE between cases, so they get
# their own database. Pointing them at the demo one would destroy the demo
# dataset on every test run, and Demo mode is a product feature, not a scratchpad.
DATABASE_URL_TEST="mysql://inventory_app:CHANGE_ME@localhost:3306/inventory_test"

# --- Auth ------------------------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="CHANGE_ME"
# Signs the device-bound JWTs used by the mobile app on /api/v1 (ARCHITECTURE §6).
# Must be different from AUTH_SECRET.
JWT_SIGNING_KEY="CHANGE_ME"

AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# The first admin, created by `npm run db:seed`. SET BOTH ON A PUBLIC SERVER.
# Unset, the seed falls back to admin@inventory.local / admin12345 — fine on a
# laptop, an open door on a box with a domain name. The seed will not change the
# password of an admin that already exists, so getting this right the first time
# is the only chance the environment gets; afterwards it is a UI job.
BOOTSTRAP_ADMIN_EMAIL="CHANGE_ME"
BOOTSTRAP_ADMIN_PASSWORD="CHANGE_ME"

# --- Application -----------------------------------------------------------
# Allow signing in against the demo database. Set false in production if the
# client does not want demo mode reachable there.
DEMO_MODE_ENABLED="true"

# --- Backups (docs/OPERATIONS.md §6) ---------------------------------------
# Where npm run backup writes. Relative to the project, or absolute. Whatever it
# points at is a full copy of the database, password hashes included — keep it
# wherever the other backups live, not somewhere web-served.
BACKUP_DIR="backups"

# Restoring OVER the live database additionally requires this set to "yes".
# Left unset deliberately: it is a real operation, and it should be typed on the
# day rather than sitting armed in a file.
# RESTORE_ALLOW_LIVE="yes"

# --- Devices (Phase 5; leave unset until hardware exists) -------------------
# Fixed RFID reader: either LLRP directly or Zebra IoT Connector over MQTT.
# RFID_LLRP_HOST=""
# RFID_LLRP_PORT="5084"
# MQTT_URL=""
# MQTT_USERNAME=""
# MQTT_PASSWORD=""

# Default printer timeouts for raw ZPL over TCP 9100.
PRINTER_TCP_PORT="9100"
PRINTER_TIMEOUT_MS="5000"

# --- Observability (optional) ----------------------------------------------
# SENTRY_DSN=""
LOG_LEVEL="info"
